class HoldRing(Gtk.Image):
    """Кольцо прогресса удержания Esc поверх круглой кнопки.

    Кадры рисуются в SVG и загружаются через GdkPixbuf, без дополнительных
    зависимостей.
    """

    STEPS = 60

    def __init__(self) -> None:
        super().__init__()
        self.set_no_show_all(True)
        self.set_halign(Gtk.Align.FILL)
        self.set_valign(Gtk.Align.FILL)
        self.value = 0.0
        self.target = 0.0
        self._source = 0
        self._cache = {}
        self.hide()

    def _frame(self, index: int):
        pixbuf = self._cache.get(index)
        if pixbuf is None:
            progress = index / self.STEPS
            circumference = 2 * math.pi * 93
            dash = circumference * progress
            svg = f"""<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200">
<circle cx="100" cy="100" r="93" fill="none" stroke="#ffffff" stroke-opacity="0.22" stroke-width="6"/>
<circle cx="100" cy="100" r="93" fill="none" stroke="#95b8ff" stroke-width="6" stroke-linecap="round"
 stroke-dasharray="{dash:.2f} {circumference:.2f}" transform="rotate(-90 100 100)"/>
</svg>"""
            try:
                loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
                loader.write(svg.encode("utf-8"))
                loader.close()
                pixbuf = loader.get_pixbuf()
            except (GLib.Error, TypeError):
                pixbuf = None
            if pixbuf is None:
                return None
            self._cache[index] = pixbuf
        return pixbuf

    def _render(self) -> None:
        index = int(round(self.value * self.STEPS))
        if index <= 0:
            self.hide()
            return
        pixbuf = self._frame(index)
        if pixbuf is None:
            self.hide()
            return
        self.set_from_pixbuf(pixbuf)
        self.show()

    def set_target(self, value: float) -> None:
        value = max(0.0, min(1.0, float(value)))
        self.target = value
        if self._source == 0:
            self._source = GLib.timeout_add(16, self._step)

    def reset(self) -> None:
        if self._source:
            GLib.source_remove(self._source)
            self._source = 0
        self.value = 0.0
        self.target = 0.0
        self.hide()

    def _step(self) -> bool:
        diff = self.target - self.value
        if abs(diff) < 0.004:
            self.value = self.target
            self._render()
            self._source = 0
            if self.value <= 0.001:
                self.value = 0.0
                self.hide()
            return False
        self.value += diff * 0.35
        self._render()
        return True


class MainWindow(Gtk.ApplicationWindow):
    def __init__(self, app: Gtk.Application) -> None:
        super().__init__(application=app, title="kblock")
        self.app = app
        self.cfg = load_config()
        override = getattr(app, "lang_override", None)
        self.lang = override if override in TRANSLATIONS else self.cfg["language"]
        if override in TRANSLATIONS and override != self.cfg["language"]:
            self.cfg["language"] = override
            save_config(self.cfg)
        self.kblock = find_kblock()
        self.proc: subprocess.Popen | None = None
        self.deadline = 0.0
        self.duration = int(self.cfg["timeout"])
        self._user_stopped = False
        self._tick_source = 0
        self._progress_source = 0
        self._term_sent = False
        self._kill_sent = False
        self._status_source = 0
        self._status_key = None
        self._status_fmt = {}
        self._status_error = False
        self._status_ok = False

        self.get_style_context().add_class("kblock-window")
        self.set_decorated(False)
        self.set_app_paintable(True)
        screen = self.get_screen()
        composited = bool(screen is not None and screen.is_composited())
        if composited:
            visual = screen.get_rgba_visual()
            if visual is not None:
                self.set_visual(visual)
        self.set_icon_name("kblock" if Gtk.IconTheme.get_default().has_icon("kblock")
                           else "input-keyboard")
        self.set_default_size(400, -1)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.connect("delete-event", self._on_delete)
        self.connect("button-press-event", self._on_window_press)

        self._build_ui()
        self.root.show_all()
        self.big.hide()
        if not composited:
            # Без композитора прозрачность не работает: делаем обычное окно.
            self.get_style_context().add_class("no-composite")
            self.frame.get_style_context().add_class("no-composite")


        if not self.kblock:
            self._set_status_key("status_missing", error=True)
            self.button.set_sensitive(False)

    # -- построение интерфейса --------------------------------------------
    def _build_ui(self) -> None:
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.root = root
        self.add(root)

        self.frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.frame.get_style_context().add_class("frame")
        root.pack_start(self.frame, True, True, 0)

        bar = self._build_headerbar()
        self.frame.pack_start(bar, False, False, 0)

        content = self._build_content()
        self.frame.pack_start(content, True, True, 0)

    def _on_window_press(self, _widget, event) -> bool:
        if event.button != 1 or not hasattr(self, "headerbar"):
            return False
        alloc = self.headerbar.get_allocation()
        origin = self.headerbar.translate_coordinates(self, 0, 0)
        if origin is None:
            return False
        ox, oy = origin
        if not (ox <= event.x < ox + alloc.width and oy <= event.y < oy + alloc.height):
            return False
        target = Gtk.get_event_widget(event)
        widget = target
        while widget is not None:
            if isinstance(widget, Gtk.Button):
                return False
            widget = widget.get_parent()
        self.begin_move_drag(event.button, int(event.x_root), int(event.y_root), event.time)
        return True

    def _build_headerbar(self) -> Gtk.HeaderBar:
        bar = Gtk.HeaderBar()
        bar.set_show_close_button(True)
        bar.get_style_context().add_class("kblock-header")
        self._build_language_button()
        bar.pack_start(self.lang_button)
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        image = Gtk.Image.new_from_icon_name(self.get_icon_name(), Gtk.IconSize.BUTTON)
        image.set_pixel_size(20)
        label = Gtk.Label(label="kblock")
        label.get_style_context().add_class("title")
        box.pack_start(image, False, False, 0)
        box.pack_start(label, False, False, 0)
        bar.set_custom_title(box)
        self.headerbar = bar
        return bar

    def _build_language_button(self) -> None:
        self.lang_button = Gtk.MenuButton()
        self.lang_button.set_relief(Gtk.ReliefStyle.NONE)
        self.lang_button.set_valign(Gtk.Align.CENTER)
        self.lang_button.get_style_context().add_class("lang-button")
        self.lang_button.set_label(LANG_SHORT.get(self.lang, self.lang.upper()))
        self.lang_button.set_tooltip_text(self._t("language"))

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.set_margin_top(6)
        box.set_margin_bottom(6)
        box.set_margin_start(6)
        box.set_margin_end(6)

        popover = Gtk.Popover.new(self.lang_button)
        popover.add(box)
        self.lang_button.set_popover(popover)

        self.lang_items = {}
        for code, name in LANGUAGES:
            item = Gtk.Button()
            item.set_relief(Gtk.ReliefStyle.NONE)
            item.get_style_context().add_class("lang-item")
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            label = Gtk.Label(label=name)
            label.set_xalign(0)
            row.pack_start(label, True, True, 0)
            check = Gtk.Image.new_from_icon_name(
                "object-select-symbolic", Gtk.IconSize.MENU,
            )
            check.set_opacity(1.0 if code == self.lang else 0.0)
            row.pack_end(check, False, False, 0)
            item.add(row)
            item.connect("clicked", self._on_lang_item, code)
            box.pack_start(item, False, False, 0)
            self.lang_items[code] = check
        box.show_all()

