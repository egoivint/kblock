        self.pointer_title.set_xalign(0)
        self.pointer_subtitle = Gtk.Label(label=self._t("pointer_subtitle"))
        self.pointer_subtitle.get_style_context().add_class("subtitle")
        self.pointer_subtitle.set_xalign(0)
        texts.pack_start(self.pointer_title, False, False, 0)
        texts.pack_start(self.pointer_subtitle, False, False, 0)
