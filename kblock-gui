def default_config() -> dict:
    return {
        "timeout": DEFAULTS["timeout"],
        "pointer": DEFAULTS["pointer"],
        "language": detect_language(),
    }


def load_config() -> dict:
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as fh:
            data = json.load(fh)
        if not isinstance(data, dict):
            return default_config()
        language = data.get("language")
        if language not in TRANSLATIONS:
            language = detect_language()
        timeout = int(data.get("timeout", DEFAULTS["timeout"]))
        timeout = max(5, min(7200, timeout))
        return {
            "timeout": timeout,
            "pointer": bool(data.get("pointer", DEFAULTS["pointer"])),
            "language": language,
        }
    except (OSError, ValueError, TypeError):
        return default_config()


def save_config(cfg: dict) -> None:
    try:
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        tmp = CONFIG_PATH + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(cfg, fh)
        os.replace(tmp, CONFIG_PATH)
    except OSError:
        pass


def find_kblock() -> str | None:
    here = os.path.dirname(os.path.realpath(__file__))
    candidates = [
        os.path.join(here, "kblock"),
        os.path.expanduser("~/.local/bin/kblock"),
        shutil.which("kblock") or "",
    ]
    for path in candidates:
        if path and os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None


def tray_icon_name() -> str:
    theme = Gtk.IconTheme.get_default()
    if theme.has_icon("kblock"):
        return "kblock"
    if theme.has_icon("input-keyboard"):
        return "input-keyboard"
    return "input-keyboard-symbolic"


# --------------------------------------------------------------------------
# трей: StatusNotifierItem + минимальный DBusMenu
# --------------------------------------------------------------------------

class Tray:
    def __init__(self, app: Gtk.Application, window: "MainWindow") -> None:
        self.app = app
        self.window = window
        self.bus_name = f"org.kde.StatusNotifierItem-{os.getpid()}-1"
        self.connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.revision = 1
        self._owner_id = Gio.bus_own_name_on_connection(
            self.connection, self.bus_name, Gio.BusNameOwnerFlags.NONE,
            self._on_name_acquired, None,
        )

    # -- SNI ---------------------------------------------------------------
    def _on_name_acquired(self, connection: Gio.DBusConnection, name: str) -> None:
        self._export_sni()
        self._export_menu()
        try:
            connection.call_sync(
                "org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
                "org.kde.StatusNotifierWatcher", "RegisterStatusNotifierItem",
                GLib.Variant("(s)", (self.bus_name,)), None,
                Gio.DBusCallFlags.NONE, 3000, None,
            )
        except GLib.Error as exc:
            print(f"kblock-gui: системный лоток недоступен: {exc.message}", file=sys.stderr)

    def _export_sni(self) -> None:
        node = Gio.DBusNodeInfo.new_for_xml(SNI_XML)
        iface = node.lookup_interface("org.kde.StatusNotifierItem")
        icon = tray_icon_name()
        self.sni_props = {
            "Category": GLib.Variant("s", "ApplicationStatus"),
            "Id": GLib.Variant("s", "kblock"),
            "Title": GLib.Variant("s", "kblock"),
            "Status": GLib.Variant("s", "Active"),
            "WindowId": GLib.Variant("i", 0),
            "IconName": GLib.Variant("s", icon),
            "IconPixmap": GLib.Variant("a(iiay)", []),
            "OverlayIconName": GLib.Variant("s", ""),
            "OverlayIconPixmap": GLib.Variant("a(iiay)", []),
            "AttentionIconName": GLib.Variant("s", ""),
            "AttentionIconPixmap": GLib.Variant("a(iiay)", []),
            "AttentionMovieName": GLib.Variant("s", ""),
            "ToolTip": GLib.Variant("(sa(iiay)ss)", (
                "", [], "kblock", self.window._t("tooltip_body"),
            )),
            "ItemIsMenu": GLib.Variant("b", False),
            "Menu": GLib.Variant("o", "/MenuBar"),
        }
        self.connection.register_object(
            "/StatusNotifierItem", iface, self._on_sni_method, self._on_sni_prop, None,
        )

    def _on_sni_prop(self, _conn, _sender, _path, _iface, prop):
        return self.sni_props.get(prop, GLib.Variant("s", ""))

    def _on_sni_method(self, _conn, _sender, _path, _iface, method, params, invocation):
        if method in ("Activate", "SecondaryActivate", "ContextMenu"):
            self.window.present()
        invocation.return_value(None)

    # -- DBusMenu ----------------------------------------------------------
    def _export_menu(self) -> None:
        node = Gio.DBusNodeInfo.new_for_xml(MENU_XML)
        iface = node.lookup_interface("com.canonical.dbusmenu")
        self.menu_props = {
            "Version": GLib.Variant("u", 3),
            "TextDirection": GLib.Variant("s", "ltr"),
            "Status": GLib.Variant("s", "normal"),
            "IconThemePath": GLib.Variant("as", []),
        }
        self.connection.register_object(
            "/MenuBar", iface, self._on_menu_method, self._on_menu_prop, None,
        )

    def _on_menu_prop(self, _conn, _sender, _path, _iface, prop):
        return self.menu_props.get(prop, GLib.Variant("u", 0))

    def _menu_item(self, item_id: int, props: dict, children: tuple = ()) -> tuple:
        """Узел меню: (id, {свойство: GVariant}, [дочерние узлы])."""
        return (
            item_id,
            {key: GLib.Variant(*value) for key, value in props.items()},
            list(children),
        )

    def _layout(self) -> tuple:
        locked = self.window.proc is not None
        return self._menu_item(0, {"children-display": ("s", "submenu")}, (
            self._menu_item(1, {
                "label": ("s", self.window._t("tray_open")),
                "enabled": ("b", True),
                "visible": ("b", True),
            }),
            self._menu_item(2, {
                "label": ("s", self.window._t("tray_lock")),
                "enabled": ("b", not locked),
                "visible": ("b", True),
            }),
            self._menu_item(4, {
                "type": ("s", "separator"),
                "visible": ("b", True),
            }),
            self._menu_item(3, {
                "label": ("s", self.window._t("tray_quit")),
                "enabled": ("b", True),
                "visible": ("b", True),
            }),
        ))

    def _props_variant(self, props: dict) -> GLib.Variant:
        builder = GLib.VariantBuilder.new(GLib.VariantType.new("a{sv}"))
        for key, value in props.items():
            builder.add_value(GLib.Variant("{sv}", (key, value)))
        return builder.end()

    def _node_variant(self, node: tuple) -> GLib.Variant:
        item_id, props, children = node
        builder = GLib.VariantBuilder.new(GLib.VariantType.new("(ia{sv}av)"))
        builder.add_value(GLib.Variant("i", item_id))
        builder.add_value(self._props_variant(props))
        child_builder = GLib.VariantBuilder.new(GLib.VariantType.new("av"))
        for child in children:
            child_builder.add_value(GLib.Variant.new_variant(self._node_variant(child)))
        builder.add_value(child_builder.end())
        return builder.end()

    def _layout_variant(self) -> GLib.Variant:
        builder = GLib.VariantBuilder.new(GLib.VariantType.new("(u(ia{sv}av))"))
        builder.add_value(GLib.Variant("u", self.revision))
        builder.add_value(self._node_variant(self._layout()))
        return builder.end()

    def _flatten(self, node: tuple, out: list) -> None:
        out.append(node)
        for child in node[2]:
            self._flatten(child, out)

    def _on_menu_method(self, _conn, _sender, _path, _iface, method, params, invocation):
        try:
            self._menu_method(method, params, invocation)
        except Exception as exc:  # noqa: BLE001 — не роняем приложение из-за D-Bus
            try:
                invocation.return_error_literal(
                    Gio.DBusError, Gio.DBusError.FAILED, str(exc),
                )
            except Exception:
                pass

    def _menu_method(self, method, params, invocation):
        if method == "GetLayout":
            response = self._layout_variant()
        elif method == "GetGroupProperties":
            ids, _names = params.unpack()
            wanted = set(ids) if ids else {0, 1, 2, 3, 4}
            flat = []
            self._flatten(self._layout(), flat)
            array = GLib.VariantBuilder.new(GLib.VariantType.new("a(ia{sv})"))
            for item_id, props, _children in flat:
                if item_id not in wanted:
                    continue
                item_builder = GLib.VariantBuilder.new(GLib.VariantType.new("(ia{sv})"))
                item_builder.add_value(GLib.Variant("i", item_id))
                item_builder.add_value(self._props_variant(props))
                array.add_value(item_builder.end())
            outer = GLib.VariantBuilder.new(GLib.VariantType.new("(a(ia{sv}))"))
            outer.add_value(array.end())
            response = outer.end()
        elif method == "GetProperty":
            item_id, prop = params.unpack()
            flat = []
            self._flatten(self._layout(), flat)
            item = next((entry for entry in flat if entry[0] == item_id), None)
            value = item[1].get(prop, GLib.Variant("s", "")) if item else GLib.Variant("s", "")
            outer = GLib.VariantBuilder.new(GLib.VariantType.new("(v)"))
            outer.add_value(GLib.Variant.new_variant(value))
            response = outer.end()
        elif method == "Event":
            item_id, event, _data, _ts = params.unpack()
            if event == "clicked":
                self._activate_item(item_id)
            response = None
        elif method == "EventGroup":
            events, = params.unpack()
            for item_id, event, _data, _ts in events:
                if event == "clicked":
                    self._activate_item(item_id)
            response = GLib.Variant("(ai)", ([],))
        elif method == "AboutToShow":
            self._bump_revision()
            response = GLib.Variant("(b)", (True,))
        elif method == "AboutToShowGroup":
            response = GLib.Variant("(aiai)", ([], []))
        else:
            invocation.return_error_literal(
                Gio.DBusError, Gio.DBusError.UNKNOWN_METHOD, f"unknown method {method}",
            )
            return
        invocation.return_value(response)

    def _bump_revision(self) -> None:
        self.revision += 1

    def refresh_texts(self) -> None:
        """Обновляет подсказку значка после смены языка."""
        if not hasattr(self, "sni_props"):
            return
        self.sni_props["ToolTip"] = GLib.Variant("(sa(iiay)ss)", (
            "", [], "kblock", self.window._t("tooltip_body"),
        ))
        try:
            self.connection.emit_signal(
                None, "/StatusNotifierItem", "org.freedesktop.DBus.Properties",
                "PropertiesChanged", GLib.Variant("(sa{sv}as)", (
                    "org.kde.StatusNotifierItem",
                    {"ToolTip": self.sni_props["ToolTip"]},
                    [],
                )),
            )
        except GLib.Error:
            pass

    def _activate_item(self, item_id: int) -> None:
        if item_id == 1:
            self.window.present()
        elif item_id == 2:
            self.window.present()
            self.window.lock_now()
        elif item_id == 3:
            self.app.quit()


