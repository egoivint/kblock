        self.hint.set_justify(Gtk.Justification.CENTER)
        self.hint.set_xalign(0.5)
        outer.pack_start(self.hint, False, False, 0)

        # карточка настроек
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.get_style_context().add_class("card")
        card_inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card_inner.set_margin_top(14)
        card_inner.set_margin_bottom(14)
        card_inner.set_margin_start(16)
        card_inner.set_margin_end(16)
        card.pack_start(card_inner, True, True, 0)
        outer.pack_start(card, False, False, 0)

        row1 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.time_title = Gtk.Label(label=self._t("time_title"))
        self.time_title.set_xalign(0)
        row1.pack_start(self.time_title, True, True, 0)

        self.spin = Gtk.SpinButton.new_with_range(5, 7200, 5)
