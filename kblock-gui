        outer.pack_start(footer, False, False, 0)

        self.content = outer
        self._update_idle_button()
        return outer

    # -- настройки ---------------------------------------------------------
    def _on_settings_changed(self, *_args) -> None:
        self.cfg = {
            "timeout": int(self.spin.get_value()),
            "pointer": bool(self.switch.get_active()),
            "language": self.lang,
        }
        if self.proc is None:
            self._update_idle_button()
        save_config(self.cfg)

    def _update_idle_button(self) -> None:
        seconds = int(self.spin.get_value())
        self.action_label.set_text(self._t("lock"))
        self.caption.set_text(self._t("caption", seconds=seconds))

    def _t(self, key: str, **fmt) -> str:
        table = TRANSLATIONS.get(self.lang) or TRANSLATIONS["ru"]
        text = table.get(key) or TRANSLATIONS["ru"].get(key, key)
        return text.format(**fmt) if fmt else text

    def _on_lang_item(self, _button, code: str) -> None:
        popover = self.lang_button.get_popover()
        if popover is not None:
            popover.popdown()
        if code not in TRANSLATIONS or code == self.lang:
            return
        self.lang = code
        self.cfg["language"] = code
        save_config(self.cfg)
        self._apply_language()
        tray = getattr(self.app, "tray", None)
        if tray is not None:
            tray.refresh_texts()

    def _apply_language(self) -> None:
        self.subtitle_label.set_text(self._t("subtitle"))
        self.time_title.set_text(self._t("time_title"))
        self.pointer_title.set_text(self._t("pointer_title"))
        self.pointer_subtitle.set_text(self._t("pointer_subtitle"))
        self.unit.set_text(self._t("unit"))
        self.lang_button.set_label(LANG_SHORT.get(self.lang, self.lang.upper()))
        self.lang_button.set_tooltip_text(self._t("language"))
        for code, check in self.lang_items.items():
            check.set_opacity(1.0 if code == self.lang else 0.0)
        self.collapse_btn.set_label(self._t("collapse"))
        self.quit_btn.set_label(self._t("quit"))
        if self.proc is None:
            self.hint.set_text(self._t("hint_idle"))
            self._update_idle_button()
        else:
            self.hint.set_text(
                self._t("hint_locked_pointer") if self.switch.get_active()
                else self._t("hint_locked")
            )
            self.caption.set_text(self._t("unit"))
        if self._status_key:
            self._show_status(
                self._t(self._status_key, **self._status_fmt),
                self._status_error, self._status_ok, 0,
            )

    # -- статус ------------------------------------------------------------
    def _set_status(self, text: str, error: bool = False, ok: bool = False,
                    clear_after: float = 0) -> None:
        self._status_key = None
        self._status_fmt = {}
        self._show_status(text, error, ok, clear_after)

    def _set_status_key(self, key: str, error: bool = False, ok: bool = False,
                        clear_after: float = 0, **fmt) -> None:
        self._status_key = key
        self._status_fmt = fmt
        self._show_status(self._t(key, **fmt), error, ok, clear_after)

    def _show_status(self, text: str, error: bool = False, ok: bool = False,
                     clear_after: float = 0) -> None:
        self._status_error = error
        self._status_ok = ok
        ctx = self.status.get_style_context()
        ctx.remove_class("error")
        ctx.remove_class("ok")
        if error:
            ctx.add_class("error")
        elif ok:
            ctx.add_class("ok")
        self.status.set_text(text)
        if self._status_source:
            GLib.source_remove(self._status_source)
            self._status_source = 0
        if text and clear_after > 0:
            self._status_source = GLib.timeout_add(
                int(clear_after * 1000), self._clear_status,
            )

    def _clear_status(self) -> bool:
        self._status_source = 0
        self._status_key = None
        self.status.set_text("")
        self.status.set_tooltip_text(None)
        return False

    # -- блокировка --------------------------------------------------------
    def lock_now(self) -> None:
        if self.proc is not None:
            return
        if not self.kblock:
            self._set_status_key("status_missing", error=True)
            return

        self.duration = int(self.spin.get_value())
        args = [self.kblock, "-t", str(self.duration), "--progress"]
        if self.switch.get_active():
            args.append("-p")
        self._user_stopped = False
        self.ring.reset()
        try:
            self.proc = subprocess.Popen(
                args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            )
        except OSError as exc:
            self.proc = None
            self._set_status_key("status_launch_failed", error=True, err=exc)
            return

        if self.proc.stdout is not None:
            self._progress_source = GLib.io_add_watch(
                self.proc.stdout, GLib.IO_IN | GLib.IO_HUP, self._on_progress,
            )
        self.deadline = time.monotonic() + self.duration
        self._term_sent = False
        self._kill_sent = False
        self._set_status("")
        self._enter_locked_ui()
        if self._tick_source:
            GLib.source_remove(self._tick_source)
        self._tick_source = GLib.timeout_add(200, self._tick)

    def _enter_locked_ui(self) -> None:
        self.icon.hide()
        self.action_label.hide()
        self.big.show()
        self.big.set_text(str(self.duration))
        self.caption.set_text(self._t("unit"))
        self.button.get_style_context().add_class("locked")
        self.spin.set_sensitive(False)
        self.switch.set_sensitive(False)
        self.hint.set_text(
            self._t("hint_locked_pointer") if self.switch.get_active()
            else self._t("hint_locked")
        )
        self.set_keep_above(True)

    def _leave_locked_ui(self) -> None:
        self.ring.reset()
        self.button.get_style_context().remove_class("locked")
        self.big.hide()
        self.icon.show()
        self.action_label.show()
        self.spin.set_sensitive(True)
        self.switch.set_sensitive(True)
        self.hint.set_text(self._t("hint_idle"))
        self.set_keep_above(False)
        self._update_idle_button()

    def _on_progress(self, source, _condition) -> bool:
        try:
            line = source.readline()
        except (OSError, ValueError):
            self._progress_source = 0
            return False
        if not line:
            self._progress_source = 0
            return False
        if line.startswith("HOLD "):
            parts = line.split()
            if len(parts) == 3:
                try:
                    held, total = float(parts[1]), float(parts[2])
                except ValueError:
                    return True
                if total > 0:
                    self.ring.set_target(min(1.0, held / total))
        return True

    def _tick(self) -> bool:
        if self.proc is None:
            self._tick_source = 0
            return False
        code = self.proc.poll()
        if code is not None:
            self._finish_lock(code)
            return False

        now = time.monotonic()
        overdue = now - self.deadline
        if overdue > 3.0 and not self._term_sent:
            self._term_sent = True
            try:
                self.proc.terminate()
            except OSError:
                pass
        elif overdue > 6.0 and not self._kill_sent:
            self._kill_sent = True
            try:
                self.proc.kill()
            except OSError:
                pass

        remaining = max(0.0, self.deadline - now)
        self.big.set_text(str(math.ceil(remaining)))
        return True

    def _finish_lock(self, code: int) -> None:
        if self.proc is None:
            return
        proc, self.proc = self.proc, None
        self._tick_source = 0
        if self._progress_source:
            GLib.source_remove(self._progress_source)
            self._progress_source = 0
        try:
            proc.stdout.close()
        except (OSError, ValueError, AttributeError):
            pass
        self.ring.reset()

        err = ""
        try:
            err = proc.stderr.read() or ""
        except (OSError, ValueError):
            pass
        try:
            proc.stderr.close()
        except (OSError, ValueError, AttributeError):
            pass

        finished = time.monotonic()
        self._leave_locked_ui()

        if self._user_stopped:
            self._set_status_key("status_stopped", clear_after=3)
        elif code == 3:
            self._set_status_key("status_no_input_access", error=True)
        elif code == 0 or (code in (-15, -9) and finished >= self.deadline):
            if finished >= self.deadline - 0.5:
                self._set_status_key("status_timeout", ok=True, clear_after=5)
            else:
                self._set_status_key("status_esc", ok=True, clear_after=5)
        else:
            self._set_status_key("status_error", error=True)

        details = err.strip()
        self.status.set_tooltip_text(details or None)

    # -- события окна ------------------------------------------------------
    def _on_button_clicked(self, _button) -> None:
        if self.proc is not None:
            self._user_stopped = True
            try:
                self.proc.terminate()
            except OSError:
                pass
        else:
            self.lock_now()

    def _on_delete(self, *_args) -> bool:
        self.hide()
        return True


