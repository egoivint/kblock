# приложение
# --------------------------------------------------------------------------

class KblockApp(Gtk.Application):
    def __init__(self, hidden: bool = False, lang: str | None = None) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.hidden = hidden
        self.lang_override = lang
        self.window: MainWindow | None = None
        self.tray: Tray | None = None
        self.connect("shutdown", self._on_shutdown)

    def do_startup(self) -> None:
        Gtk.Application.do_startup(self)
        settings = Gtk.Settings.get_default()
        if settings is not None:
            settings.set_property("gtk-application-prefer-dark-theme", True)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        screen = Gdk.Screen.get_default()
        if screen is not None:
            Gtk.StyleContext.add_provider_for_screen(
                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )

    def do_activate(self) -> None:
        if self.window is None:
            self.window = MainWindow(self)
            self.add_window(self.window)
            try:
                self.tray = Tray(self, self.window)
            except GLib.Error as exc:
                print(f"kblock-gui: трей недоступен: {exc.message}", file=sys.stderr)
        if self.hidden:
            self.hidden = False
        else:
            self.window.present()

    def _on_shutdown(self, *_args) -> None:
        if self.window is not None and self.window.proc is not None:
            try:
                self.window.proc.terminate()
            except OSError:
                pass


def main() -> int:
    GLib.set_prgname("kblock-gui")
    GLib.set_application_name("kblock")
    hidden = False
    lang = None
    argv = [sys.argv[0]]
    index = 1
    while index < len(sys.argv):
        arg = sys.argv[index]
        if arg == "--hidden":
            hidden = True
        elif arg == "--lang" and index + 1 < len(sys.argv):
            lang = sys.argv[index + 1]
            index += 1
        elif arg.startswith("--lang="):
            lang = arg.split("=", 1)[1]
        else:
            argv.append(arg)
        index += 1
    if lang not in TRANSLATIONS:
        lang = None

    app = KblockApp(hidden=hidden, lang=lang)

    def _quit(_signum: int = 0) -> bool:
        app.quit()
        return False

    for sig in (signal.SIGINT, signal.SIGTERM):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, _quit)

    try:
        return app.run(argv)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
