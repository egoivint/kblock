        self.spin.set_width_chars(4)
        self.spin.set_value(self.cfg["timeout"])
        self.spin.connect("value-changed", self._on_settings_changed)
        row1.pack_start(self.spin, False, False, 0)

        self.unit = Gtk.Label(label=self._t("unit"))
        self.unit.get_style_context().add_class("subtitle")
        row1.pack_start(self.unit, False, False, 0)
        card_inner.pack_start(row1, False, False, 0)

        row2 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
