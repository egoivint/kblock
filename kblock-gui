        self.subtitle_label.get_style_context().add_class("subtitle")
        self.subtitle_label.set_xalign(0.5)
        outer.pack_start(self.subtitle_label, False, False, 0)

        # круглая кнопка
        self.button = Gtk.Button()
        self.button.set_size_request(200, 200)
        self.button.set_halign(Gtk.Align.CENTER)
        self.button.set_valign(Gtk.Align.CENTER)
        self.button.get_style_context().add_class("lock")
        self.button.connect("clicked", self._on_button_clicked)

        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
